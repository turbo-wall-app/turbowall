[
  {
    "id": "block-bad-ip-ranges",
    "action": "block",
    "expression": "ip.src == \"203.0.113.*\" or ip.src == \"198.51.*.*\""
  },
  {
    "id": "block-bots-regex",
    "action": "block",
    "expression": "http.user_agent matches \"(?i)^(curl|wget|python-requests|scapy)\""
  },
  {
    "id": "log-api-v1-deprecation",
    "action": "log",
    "expression": "http.request.uri.path matches \"^/api/v1/[0-9]+\""
  },
  {
    "id": "allow-good-bot",
    "action": "allow",
    "expression": "http.user_agent contains \"MyTrustedBot\""
  },
  {
    "id": "block-complex-attack",
    "action": "block",
    "expression": "(http.request.uri.path contains \".php\" or http.request.uri.path contains \"UNION SELECT\") and http.request.method != \"GET\""
  }
]
