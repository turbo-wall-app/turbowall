[
  {
    "id": "block-bad-ip-ranges",
    "action": "block",
    "expression": "ip.src == \"203.0.113.*\" or ip.src == \"198.51.*.*\""
  },
  {
    "id": "block-bots-regex",
    "action": "block",
    "expression": "http.user_agent matches \"(?i)^(curl|wget|python-requests|scapy)\""
  },
  {
    "id": "log-api-v1-deprecation",
    "action": "log",
    "expression": "http.request.uri.path matches \"^/api/v1/[0-9]+\""
  },
  {
    "id": "allow-good-bot",
    "action": "allow",
    "expression": "http.user_agent contains \"MyTrustedBot\""
  },
  {
    "id": "block-complex-attack",
    "action": "block",
    "expression": "(http.request.uri.path contains \".php\" or http.request.uri.path contains \"UNION SELECT\") and http.request.method != \"GET\""
  },
  {
    "id": "block-xss-request",
    "phase": "request",
    "action": "block",
    "expression": "http.request.body matches \"(?i)(<script|javascript:|onerror\\\\s*=)\" or http.request.uri.path matches \"(?i)(<script|javascript:|onerror\\\\s*=)\""
  },
  {
    "id": "block-sql-injection-body",
    "phase": "request",
    "action": "block",
    "expression": "http.request.body matches \"(?i)(UNION\\\\s+SELECT|DROP\\\\s+TABLE)\""
  },
  {
    "id": "block-xss-response",
    "phase": "response",
    "action": "block",
    "expression": "http.response.body matches \"(?i)(<script[^>]*>alert\\\\(|javascript:)\""
  },
  {
    "id": "block-data-leak",
    "phase": "response",
    "action": "block",
    "expression": "http.response.body contains \"-----BEGIN PRIVATE KEY-----\""
  }
]
